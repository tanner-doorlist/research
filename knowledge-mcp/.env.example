# Copy to .env and fill in values

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Path to your research directory (default: ~/research)
# RESEARCH_DIR=/Users/yourname/research

# ChromaDB connection (default: localhost:8000 from docker-compose)
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Cosine similarity threshold for deduplication (0–1, default 0.88)
# Higher = stricter, only near-identical notes get merged
# DEDUP_THRESHOLD=0.88
