#!/usr/bin/env bash
set -euo pipefail

# Start the research dev environment.
# Launches Postgres via Docker Compose, then the Electron app with hot reload.
#
# Usage:
#   ./scripts/dev                              # uses repo dir as RESEARCH_DIR
#   RESEARCH_DIR=~/research ./scripts/dev      # uses ~/research for data

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export RESEARCH_DIR="${RESEARCH_DIR:-$REPO_DIR}"

echo "==> Research dev environment"
echo "    Repo:         $REPO_DIR"
echo "    Data dir:     $RESEARCH_DIR"
echo ""

# ── Preflight checks ─────────────────────────────────────────────────────────
if [ ! -d "$REPO_DIR/study-notifier/node_modules" ]; then
  echo "    node_modules missing — running setup first"
  "$REPO_DIR/scripts/setup"
  echo ""
fi

if ! command -v docker &> /dev/null; then
  echo "ERROR: Docker is required. Install Docker Desktop."
  exit 1
fi

# ── Docker Compose services ──────────────────────────────────────────────────
cd "$REPO_DIR"

# Stop old knowledge-mcp compose if it's holding ports
if [ -f "$REPO_DIR/knowledge-mcp/docker-compose.yml" ]; then
  cd "$REPO_DIR/knowledge-mcp"
  docker compose down 2>/dev/null || true
  cd "$REPO_DIR"
fi

# Stop any container holding port 5432 (e.g. another worktree's Postgres)
BLOCKING_CONTAINER=$(docker ps --filter "publish=5432" --format "{{.Names}}" 2>/dev/null | head -1)
if [ -n "$BLOCKING_CONTAINER" ]; then
  echo "    Stopping $BLOCKING_CONTAINER (holding port 5432)"
  docker stop "$BLOCKING_CONTAINER" 2>/dev/null || true
fi

echo "==> Starting Postgres"
docker compose up -d

# Wait for Postgres
echo "    Waiting for Postgres..."
for i in $(seq 1 20); do
  if docker compose exec -T postgres pg_isready -U postgres -q 2>/dev/null; then
    echo "    Postgres ready"
    break
  fi
  if [ "$i" -eq 20 ]; then
    echo "    Warning: Postgres didn't become ready"
  fi
  sleep 1
done

cleanup() {
  echo ""
  echo "==> Shutting down Docker services"
  cd "$REPO_DIR"
  docker compose stop
}
trap cleanup EXIT INT TERM

# ── Electron app with hot reload ──────────────────────────────────────────────
echo "==> Starting study-notifier (Electron + Vite)"
echo ""
cd "$REPO_DIR/study-notifier"
exec npx concurrently -k \
  "vite" \
  "wait-on http://localhost:5173 && RESEARCH_DIR=$RESEARCH_DIR VITE_DEV_SERVER_URL=http://localhost:5173 electron ."
